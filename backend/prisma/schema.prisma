generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Tabel Roles
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// Tabel Users
model User {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(150)
  email        String @unique @db.VarChar(150)
  passwordHash String @db.VarChar(255)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRequisitions  Requisition[]     @relation("RequisitionCreator")
  approvedRequisitions Requisition[]     @relation("RequisitionApprover")
  approvalActions      ApprovalHistory[] @relation("ApprovalActor")

  createdInvoices  Invoice[] @relation("InvoiceCreator")
  verifiedInvoices Invoice[] @relation("InvoiceVerifier")

  @@index([roleId])
  @@map("users")

  notifications Notification[]
}

enum VendorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Vendor {
  id             Int             @id @default(autoincrement())
  vendorCode     String          @unique @db.VarChar(50)
  companyName    String          @db.VarChar(200)
  contactName    String?         @db.VarChar(150)
  email          String?         @unique @db.VarChar(150)
  phone          String?         @db.VarChar(30)
  taxNumber      String?         @db.VarChar(50)
  address        String?         @db.Text
  city           String?         @db.VarChar(100)
  country        String?         @db.VarChar(100)
  website        String?         @db.VarChar(200)
  status         VendorStatus    @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@index([companyName])
  @@index([status])
  @@map("vendors")
}

enum RequisitionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

model Requisition {
  id            Int               @id @default(autoincrement())
  requestNumber String            @unique @db.VarChar(50)
  title         String            @db.VarChar(200)
  description   String?           @db.Text
  department    String            @db.VarChar(100)
  neededDate    DateTime?
  status        RequisitionStatus @default(DRAFT)

  requestedById Int
  requestedBy   User @relation("RequisitionCreator", fields: [requestedById], references: [id])

  approvedById Int?
  approvedBy   User? @relation("RequisitionApprover", fields: [approvedById], references: [id])

  rejectionReason String? @db.Text

  items RequisitionItem[]

  approvalHistory ApprovalHistory[]
  purchaseOrder   PurchaseOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestedById])
  @@map("requisitions")
}

model RequisitionItem {
  id            Int         @id @default(autoincrement())
  requisitionId Int
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  itemName           String  @db.VarChar(200)
  description        String? @db.Text
  quantity           Int
  unit               String  @db.VarChar(50)
  estimatedUnitPrice Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId])
  @@map("requisition_items")
}

model ApprovalHistory {
  id Int @id @default(autoincrement())

  requisitionId Int
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  actorId Int
  actor   User @relation("ApprovalActor", fields: [actorId], references: [id])

  action   ApprovalAction
  comments String?        @db.Text

  createdAt DateTime @default(now())

  @@index([requisitionId])
  @@index([actorId])
  @@map("approval_history")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id       Int    @id @default(autoincrement())
  poNumber String @unique @db.VarChar(50)

  requisitionId Int         @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id])

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  orderDate    DateTime  @default(now())
  deliveryDate DateTime?

  status PurchaseOrderStatus @default(DRAFT)

  notes       String? @db.Text
  subtotal    Decimal @db.Decimal(15, 2)
  tax         Decimal @default(0) @db.Decimal(15, 2)
  totalAmount Decimal @db.Decimal(15, 2)

  items    PurchaseOrderItem[]
  invoices Invoice[]

  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id Int @id @default(autoincrement())

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  itemName    String  @db.VarChar(200)
  description String? @db.Text
  quantity    Int
  unit        String  @db.VarChar(50)

  unitPrice  Decimal @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)

  goodsReceiptItems GoodsReceiptItem[]
  invoiceItems      InvoiceItem[]

  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum GoodsReceiptStatus {
  PARTIAL
  COMPLETED
}

model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  receiptNumber   String             @unique @db.VarChar(50)
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedDate    DateTime           @default(now())
  receivedBy      String?            @db.VarChar(150)
  notes           String?            @db.Text
  status          GoodsReceiptStatus @default(PARTIAL)
  items           GoodsReceiptItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedDate])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id Int @id @default(autoincrement())

  goodsReceiptId Int
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  quantityReceived Int @default(0)
  quantityDamaged  Int @default(0)

  stockTransaction StockTransaction?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

// ==========================================
// INVENTORY MANAGEMENT
// ==========================================

enum StockTransactionType {
  IN
  OUT
  ADJUSTMENT
}

// Master barang
model InventoryItem {
  id          Int     @id @default(autoincrement())
  itemCode    String  @unique @db.VarChar(50)
  itemName    String  @db.VarChar(200)
  description String? @db.Text
  category    String? @db.VarChar(100)
  unit        String  @db.VarChar(50)

  minimumStock Int     @default(0)
  isActive     Boolean @default(true)

  purchaseOrderItems PurchaseOrderItem[]
  stocks             InventoryStock[]
  transactions       StockTransaction[]
  stockOpnameItems   StockOpnameItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemName])
  @@index([category])
  @@map("inventory_items")
}

// Data gudang
model Warehouse {
  id            Int     @id @default(autoincrement())
  warehouseCode String  @unique @db.VarChar(50)
  warehouseName String  @db.VarChar(150)
  address       String? @db.Text
  description   String? @db.Text
  isActive      Boolean @default(true)

  goodsReceipts GoodsReceipt[]
  stocks        InventoryStock[]
  transactions  StockTransaction[]
  stockOpnames  StockOpname[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// Stok barang per gudang
model InventoryStock {
  id Int @id @default(autoincrement())

  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryItemId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_stocks")
}

// Riwayat transaksi stok
model StockTransaction {
  id Int @id @default(autoincrement())

  transactionNumber String               @unique @db.VarChar(50)
  transactionType   StockTransactionType

  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Positif untuk stok masuk, negatif untuk stok keluar
  quantityChange Int

  stockBefore Int
  stockAfter  Int

  referenceNumber String? @db.VarChar(100)
  notes           String? @db.Text
  performedBy     String? @db.VarChar(150)

  goodsReceiptItemId Int?              @unique
  goodsReceiptItem   GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id])

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("stock_transactions")
}

enum StockOpnameStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  PAID
}

model StockOpname {
  id           Int               @id @default(autoincrement())
  opnameNumber String            @unique @db.VarChar(50)
  warehouseId  Int
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  opnameDate   DateTime          @default(now())
  notes        String?           @db.Text
  status       StockOpnameStatus @default(DRAFT)
  items        StockOpnameItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([warehouseId])
  @@index([status])
  @@map("stock_opnames")
}

model StockOpnameItem {
  id            Int         @id @default(autoincrement())
  stockOpnameId Int
  stockOpname   StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)

  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  systemStock   Int
  physicalStock Int
  difference    Int

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockOpnameId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("stock_opname_items")
}

// ==========================================
// INVOICE MANAGEMENT
// ==========================================

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber       String  @unique @db.VarChar(50)
  vendorInvoiceNumber String? @db.VarChar(100)

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  invoiceDate DateTime
  dueDate     DateTime?

  status InvoiceStatus @default(DRAFT)

  subtotal    Decimal @db.Decimal(15, 2)
  tax         Decimal @default(0) @db.Decimal(15, 2)
  totalAmount Decimal @db.Decimal(15, 2)

  notes           String? @db.Text
  rejectionReason String? @db.Text

  createdById Int
  createdBy   User @relation("InvoiceCreator", fields: [createdById], references: [id])

  verifiedById Int?
  verifiedBy   User? @relation("InvoiceVerifier", fields: [verifiedById], references: [id])

  verifiedAt DateTime?
  paidAt     DateTime?

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  purchaseOrderItemId Int
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  itemName String @db.VarChar(200)
  quantity Int
  unit     String @db.VarChar(50)

  unitPrice  Decimal @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("invoice_items")
}


model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String   @db.VarChar(150)
  message       String   @db.Text
  type          String   @db.VarChar(50)
  referenceId   Int?
  referenceType String?  @db.VarChar(50)
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}