generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Tabel Roles
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

// Tabel Users
model User {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(150)
  email        String @unique @db.VarChar(150)
  passwordHash String @db.VarChar(255)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRequisitions  Requisition[] @relation("RequisitionCreator")
  approvedRequisitions Requisition[] @relation("RequisitionApprover")
  approvalActions      ApprovalHistory[] @relation("ApprovalActor")

  @@index([roleId])
  @@map("users")
}

enum VendorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Vendor {
  id          Int          @id @default(autoincrement())
  vendorCode  String       @unique @db.VarChar(50)
  companyName String       @db.VarChar(200)
  contactName String?      @db.VarChar(150)
  email       String?      @unique @db.VarChar(150)
  phone       String?      @db.VarChar(30)
  taxNumber   String?      @db.VarChar(50)
  address     String?      @db.Text
  city        String?      @db.VarChar(100)
  country     String?      @db.VarChar(100)
  website     String?      @db.VarChar(200)
  status      VendorStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([companyName])
  @@index([status])
  @@map("vendors")
}

enum RequisitionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

model Requisition {
  id            Int               @id @default(autoincrement())
  requestNumber String            @unique @db.VarChar(50)
  title         String            @db.VarChar(200)
  description   String?           @db.Text
  department    String            @db.VarChar(100)
  neededDate    DateTime?
  status        RequisitionStatus @default(DRAFT)

  requestedById Int
  requestedBy   User @relation("RequisitionCreator", fields: [requestedById], references: [id])

  approvedById Int?
  approvedBy   User? @relation("RequisitionApprover", fields: [approvedById], references: [id])

  rejectionReason String? @db.Text

  items RequisitionItem[]

  approvalHistory ApprovalHistory[]
  purchaseOrder PurchaseOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestedById])
  @@map("requisitions")
}

model RequisitionItem {
  id            Int         @id @default(autoincrement())
  requisitionId Int
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  itemName           String  @db.VarChar(200)
  description        String? @db.Text
  quantity           Int
  unit               String  @db.VarChar(50)
  estimatedUnitPrice Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId])
  @@map("requisition_items")
}


model ApprovalHistory {
  id Int @id @default(autoincrement())

  requisitionId Int
  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  actorId Int
  actor User @relation("ApprovalActor", fields: [actorId], references: [id])

  action ApprovalAction
  comments String? @db.Text

  createdAt DateTime @default(now())

  @@index([requisitionId])
  @@index([actorId])
  @@map("approval_history")
}


enum PurchaseOrderStatus {
  DRAFT
  SENT
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id          Int      @id @default(autoincrement())
  poNumber    String   @unique @db.VarChar(50)

  requisitionId Int         @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id])

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  orderDate    DateTime  @default(now())
  deliveryDate DateTime?

  status PurchaseOrderStatus @default(DRAFT)

  notes       String?  @db.Text
  subtotal    Decimal  @db.Decimal(15, 2)
  tax         Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount Decimal  @db.Decimal(15, 2)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id Int @id @default(autoincrement())

  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  itemName    String  @db.VarChar(200)
  description String? @db.Text
  quantity    Int
  unit        String  @db.VarChar(50)

  unitPrice Decimal @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}
